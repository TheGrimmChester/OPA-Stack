<?xml version="1.0"?>
<!--
  Smoke-test tolerance settings for the `default` profile.
  These make JSONEachRow inserts from the agent forgiving so the smoke test
  exercises the data path even though the agent emits a superset/subset of
  columns and sends nulls for optional pointer fields.
  (In production the agent should own an explicit, versioned schema instead.)
-->
<clickhouse>
  <profiles>
    <default>
      <input_format_skip_unknown_fields>1</input_format_skip_unknown_fields>
      <input_format_null_as_default>1</input_format_null_as_default>
      <date_time_input_format>best_effort</date_time_input_format>
    </default>
  </profiles>
</clickhouse>
