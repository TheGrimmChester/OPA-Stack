# Example — copy into a consuming app repo. Not enabled in OPA-stack CI by default.
name: opa-perf-gate
on:
  workflow_dispatch:
  pull_request:
jobs:
  gate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Call OPA perf gate
        env:
          AGENT_URL: ${{ secrets.OPA_AGENT_URL }}
          BASELINE_ID: ${{ secrets.OPA_PERF_BASELINE_ID }}
        run: |
          curl -fsS -o gate.json "$AGENT_URL/api/performance/gate?id=$BASELINE_ID"
          cat gate.json
          grep -q '"pass":false\|"ok":false' gate.json && exit 1 || true
