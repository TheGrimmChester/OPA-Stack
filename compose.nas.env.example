# Example environment for compose.nas.yaml on the NAS host.
# Copy values into /mnt/Apps/config-docker/open-stack/.env — never commit secrets.

# --- Compose file selection (required) ---
# Makes a plain `docker compose` in the stack directory resolve to
# compose.nas.yaml, so the host needs no second copy named docker-compose.yaml.
# Keeping both files is what breaks `docker compose config`: the two definitions
# merge and the collector group list is appended to itself.
COMPOSE_FILE=compose.nas.yaml

# --- Host docker group (collector) ---
# GID that owns /var/run/docker.sock. It is added to the non-root collector so it
# can read container stats. Check with `getent group docker`; 999 on this NAS.
# OPA_DOCKER_GID=999

#
# Required for co-deployed auth (see docs/nas-deploy.md):
# JWT_SECRET=
# OPEN_SERVICE_JWT_SECRET=
# OPA_HUB_ENROLL_TOKEN=

# --- Alert notifications (edge agent) ---
# Default OPA_ALERT_NOTIFY_MODE=deliver sends to configured channels.
# Use log (or log-only / dry-run) for safe end-to-end tests without SMTP, chat or webhook calls.
# OPA_ALERT_NOTIFY_MODE=deliver

# --- SMTP relay (shared: edge agent alert email + OPL run email) ---
# When OPA_SMTP_HOST is unset, email rules still fire but history status is logged
# (intentional no-send — notifications are never silently dropped).
# OPA_SMTP_HOST=smtp.example.com
# OPA_SMTP_PORT=587
# OPA_SMTP_USER=your-smtp-user
# OPA_SMTP_PASS=your-smtp-password
# OPA_SMTP_FROM=opa-alerts@example.com

# --- OPL terminal-run notification channels (optional) ---
# Three channels (webhook, chat, email) share one terminal-run event and one set
# of controls. Keep every URL, secret and recipient list in .env — never commit.
# OPL_RUN_NOTIFY_MODE=deliver
# Use log (or log-only / dry-run) for safe E2E without outbound HTTP or mail.
# OPL_RUN_NOTIFY_MODE=log
# OPL_RUN_NOTIFY_STATUSES=failed,cancelled
# Restrict which channels are attempted (empty = all): webhook,chat,email
# OPL_RUN_NOTIFY_CHANNELS=
#
# webhook channel — raw JSON POST, optionally HMAC-signed
# OPL_RUN_WEBHOOK_URL=
# OPL_RUN_WEBHOOK_SECRET=
#
# chat channel — incoming-webhook message payload (text + colored attachment)
# OPL_RUN_CHAT_WEBHOOK_URL=
#
# email channel — recipients plus the shared SMTP block above. Without
# OPA_SMTP_HOST the recipients are recorded as logged, never dropped.
# OPL_RUN_EMAIL_TO=perf-oncall@example.com
# OPL_RUN_EMAIL_FROM=
#
# OPL_PUBLIC_URL=

# --- OPM model-backed runner (optional) ---
# OpenAI-compatible chat completions inside opm-runner-task.
# When OPM_MODEL_API_KEY is unset, jobs still spawn the container (execution=container)
# but the runner reports mode=fallback and the control plane writes builtin artifacts.
# OPM_MODEL_API_KEY=
# OPM_MODEL_BASE_URL=https://api.openai.com/v1
# OPM_MODEL=gpt-4o-mini
# OPM_MODEL_PLANNING=
# OPM_MODEL_CODING=
# OPM_MODEL_REVIEW=
# OPM_RUNNER_NETWORK=bridge
