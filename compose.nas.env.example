# Example environment for compose.nas.yaml on the NAS host.
# Copy values into /mnt/Apps/config-docker/open-stack/.env — never commit secrets.
#
# Required for co-deployed auth (see docs/nas-deploy.md):
# JWT_SECRET=
# OPEN_SERVICE_JWT_SECRET=
# OPA_HUB_ENROLL_TOKEN=

# --- Alert email (edge agent only) ---
# Default OPA_ALERT_NOTIFY_MODE=deliver sends to configured channels.
# Use log (or log-only / dry-run) for safe end-to-end tests without SMTP/Slack/webhooks.
# OPA_ALERT_NOTIFY_MODE=deliver

# When OPA_SMTP_HOST is unset, email alert rules still fire but history status is logged
# (intentional no-send — alerts are never silently dropped).
# OPA_SMTP_HOST=smtp.example.com
# OPA_SMTP_PORT=587
# OPA_SMTP_USER=your-smtp-user
# OPA_SMTP_PASS=your-smtp-password
# OPA_SMTP_FROM=opa-alerts@example.com

# --- OPL terminal-run webhook (optional) ---
# POST JSON to this URL when a load run reaches terminal status.
# Keep the URL/secret in .env only — never commit.
# OPL_RUN_WEBHOOK_URL=
# OPL_RUN_NOTIFY_MODE=deliver
# Use log (or log-only / dry-run) for safe E2E without outbound HTTP.
# OPL_RUN_NOTIFY_MODE=log
# OPL_RUN_NOTIFY_STATUSES=failed,cancelled
# OPL_RUN_WEBHOOK_SECRET=
# OPL_PUBLIC_URL=

# --- OPM model-backed runner (optional) ---
# OpenAI-compatible chat completions inside opm-runner-task.
# When OPM_MODEL_API_KEY is unset, jobs still spawn the container (execution=container)
# but the runner reports mode=fallback and the control plane writes builtin artifacts.
# OPM_MODEL_API_KEY=
# OPM_MODEL_BASE_URL=https://api.openai.com/v1
# OPM_MODEL=gpt-4o-mini
# OPM_MODEL_PLANNING=
# OPM_MODEL_CODING=
# OPM_MODEL_REVIEW=
# OPM_RUNNER_NETWORK=bridge
