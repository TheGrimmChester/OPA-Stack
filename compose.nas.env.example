# Example environment for compose.nas.yaml on the NAS host.
# Copy values into /mnt/Apps/config-docker/open-stack/.env — never commit secrets.

# --- Compose file selection (required) ---
# Makes a plain `docker compose` in the stack directory resolve to
# compose.nas.yaml, so the host needs no second copy named docker-compose.yaml.
# Keeping both files is what breaks `docker compose config`: the two definitions
# merge and the collector group list is appended to itself.
COMPOSE_FILE=compose.nas.yaml

# --- Host docker group (collector) ---
# GID that owns /var/run/docker.sock. It is added to the non-root collector so it
# can read container stats. Check with `getent group docker`; 999 on this NAS.
# OPA_DOCKER_GID=999

#
# Required for co-deployed auth (see docs/nas-deploy.md):
# JWT_SECRET=
# OPEN_SERVICE_JWT_SECRET=
# OPA_HUB_ENROLL_TOKEN=
#
# Connector / credential ciphertext (AES-GCM). REQUIRED by compose.nas.yaml
# (${OPA_CONNECTOR_SECRET:?…} — unset aborts `docker compose up`).
# MUST be distinct from JWT_SECRET and OPEN_SERVICE_JWT_SECRET going forward.
# Set the same value as OAM_SECRET_KEY (or leave OAM_SECRET_KEY unset so it falls
# back to this). Existing NAS installs that previously aliased this to JWT_SECRET
# should set OPA_CONNECTOR_SECRET to those same historical bytes until a deliberate
# re-encrypt/rotate — then set a new dedicated secret and recreate ora-api + oam-api.
# OPA_CONNECTOR_SECRET=

# --- Alert notifications (edge agent) ---
# Default OPA_ALERT_NOTIFY_MODE=deliver sends to configured channels.
# Use log (or log-only / dry-run) for safe end-to-end tests without SMTP, chat or webhook calls.
# OPA_ALERT_NOTIFY_MODE=deliver

# --- SMTP relay (shared: edge agent alert email + OPL run email) ---
# When OPA_SMTP_HOST is unset, email rules still fire but history status is logged
# (intentional no-send — notifications are never silently dropped).
# OPA_SMTP_HOST=smtp.example.com
# OPA_SMTP_PORT=587
# OPA_SMTP_USER=your-smtp-user
# OPA_SMTP_PASS=your-smtp-password
# OPA_SMTP_FROM=opa-alerts@example.com

# --- OPL terminal-run notification channels (optional) ---
# Three channels (webhook, chat, email) share one terminal-run event and one set
# of controls. Keep every URL, secret and recipient list in .env — never commit.
# OPL_RUN_NOTIFY_MODE=deliver
# Use log (or log-only / dry-run) for safe E2E without outbound HTTP or mail.
# OPL_RUN_NOTIFY_MODE=log
# OPL_RUN_NOTIFY_STATUSES=failed,cancelled
# Restrict which channels are attempted (empty = all): webhook,chat,email
# OPL_RUN_NOTIFY_CHANNELS=
#
# webhook channel — raw JSON POST, optionally HMAC-signed
# OPL_RUN_WEBHOOK_URL=
# OPL_RUN_WEBHOOK_SECRET=
#
# chat channel — incoming-webhook message payload (text + colored attachment)
# OPL_RUN_CHAT_WEBHOOK_URL=
#
# email channel — recipients plus the shared SMTP block above. Without
# OPA_SMTP_HOST the recipients are recorded as logged, never dropped.
# OPL_RUN_EMAIL_TO=perf-oncall@example.com
# OPL_RUN_EMAIL_FROM=
#
# OPL_PUBLIC_URL=

# OPL Perf Lab — allow listed hosts/IPs past dial-pin at validate/dispatch (lab only).
# Example for this NAS host when HARs target http://192.168.100.101:...
# OPA_PERF_INTERNAL_HOSTS=192.168.100.101

# --- OAM: the account plane (orgs, users, credentials, per-agent models) ---
# Encrypts secrets at rest. It MUST derive to the same bytes as the key ORA
# already uses, because the migration copies ORA's ciphertext verbatim instead of
# re-encrypting it. Leave this unset and OAM falls back to OPA_CONNECTOR_SECRET,
# which is what an existing install already has — that is the zero-config path.
# Setting it to a *different* value is the one change that makes every migrated
# credential undecryptable (it fails closed and logs; it never returns garbage).
# OAM_SECRET_KEY=
#
# OPEN_SERVICE_JWT_SECRET (set above) is REQUIRED for oam-api: credential
# resolution refuses to serve without it, because a peer that cannot be
# authenticated must not receive a plaintext key.
#
# Post-install / claim browsers redirect to OAM Connectors (not OPA :8088).
# Compose defaults to http://192.168.100.101:18097 when unset.
# OAM_DASHBOARD_URL=http://192.168.100.101:18097

# --- OPM model selection ---
# Models and API keys resolve PER JOB from OAM (PEER_OAM_URL is set in
# compose.nas.yaml), scoped to the acting user's org and the per-agent binding for
# How many endpoints a resolve hands a job, so it can fall through to the next
# when one is over quota or unreachable. This is an exposure bound, not a tuning
# knob: the job env holds one credential per candidate. Clamped to 1..10; set 1 to
# keep the pre-failover blast radius of a single key per job.
#OAM_RESOLVE_MAX_CANDIDATES=3
#
# that job's phase. Configure them in the OAM console's Agents & Models page, or
# via POST /api/models/bindings/set — not here.
#
# A job whose org has no credential fails closed with credential_unavailable
# rather than borrowing a deployment-wide key.
#
# Everything below is the LEGACY path, read only when PEER_OAM_URL is unset. It is
# kept so a deployment can roll back to pre-OAM behaviour with no code change.
# These variables applied to the whole deployment, which is why no organization,
# project or user could choose their own model.
# OPM_MODEL_API_KEY=
# OPM_MODEL_BASE_URL=https://api.openai.com/v1
# OPM_MODEL=auto
# OPM_MODEL_PLANNING=auto
# OPM_MODEL_CODING=auto
# OPM_MODEL_REVIEW=auto
# OPM_MODEL_IDEATION=auto
# OPM_MODEL_ROADMAP_DISCOVERY=auto
# OPM_MODEL_ROADMAP_FEATURES=auto
# OPM_RUNNER_NETWORK=bridge

# --- OPA Checkup workspace (ORA) ---
# Sibling module sources used to resolve go.mod filesystem replaces
# (replace … => ../Open-Auth-Go) inside the isolated per-job checkout.
# Defaults to the NAS family source tree; compose mounts it read-only.
# Unset or wrong => OPA Checkup reports "could not run" (neutral) instead of
# failing the pull request, and no tests execute.
# OPA_CHECKUP_MODULE_SRC=/mnt/Apps/config-docker/open-stack/src

# Seconds the AppSec Gate waits for the OSA security run to reach a terminal
# state before reporting scan_incomplete (neutral).
# OPA_GATE_WAIT_TIMEOUT_SEC=600

# --- Per-family security Redis (required for compose.nas.yaml) ---
# One dedicated Redis per control plane; unique password per instance.
# Generate with: openssl rand -base64 24
# REDIS_OPA_PASSWORD=
# REDIS_OAM_PASSWORD=
# REDIS_ORA_PASSWORD=
# REDIS_OSA_PASSWORD=
# REDIS_OPL_PASSWORD=
# REDIS_OPM_PASSWORD=
#
# APIs receive REDIS_URL from compose (redis://:password@redis-<product>:6379/0).
# Job runners and the edge agent must never receive REDIS_URL — it is denylisted
# in Open-Job-Env-Go / ORA job_env.go.

# --- Job sandbox defaults (NAS) ---
# compose.nas.yaml defaults OPA_JOB_SANDBOX=docker for ora-api and osa-api.
# Break-glass host exec: OPA_JOB_SANDBOX=off (admin only).
# OPM_RUNNER_NETWORK defaults to internal+proxy; override OPM_RUNNER_NETWORK=bridge
# only until opm-api spawn interprets the internal+proxy sentinel like ORA.
